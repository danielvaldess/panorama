# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# ===== IA (OpenRouter) =====
# Gateway único de IA. La key real vive en el servidor (Dokku config), no aquí.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ===== App =====
ENVIRONMENT=development
# (añadir aquí las variables del stack cuando se confirme el reto)
