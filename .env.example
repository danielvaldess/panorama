# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# ===== IA =====
# Proveedor principal: OpenCode Zen (plan Go), endpoint compatible OpenAI.
# La key real vive en el servidor (Dokku config) o en .env local, nunca en el repo.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
# Modelos FREE primero ($0). Si quieres más potencia, agrega un modelo de pago al final.
OPENCODE_MODELS=mimo-v2.6-flash-free,mimo-v2.5-free,nemotron-3.5-lightning-free,longcat-2.5-preview-free,space-bunny-free,ling-3.1-flash-free

# Respaldo (opcional): OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODELS=inclusionai/ling-3.0-flash-sante:free,dots-studio/dots-3-note-preview:free

# ===== App =====
ENVIRONMENT=development
REFRESH_SECONDS=900
MAX_FICHAS=40
AI_TOP_N=6

# Opcional: si se define, /api/review, /api/refresh y /api/analyze requieren header X-Panorama-Token.
PANORAMA_ADMIN_TOKEN=
