# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# ===== IA (OpenRouter) =====
# Gateway único de IA. La key real vive en el servidor (Dokku config), no aquí.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_MODELS=inclusionai/ling-3.0-flash-sante:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-lightning:free

# ===== App =====
ENVIRONMENT=development
REFRESH_SECONDS=900
MAX_FICHAS=40
AI_TOP_N=6

# Opcional: si se define, /api/review, /api/refresh y /api/analyze requieren header X-Panorama-Token.
PANORAMA_ADMIN_TOKEN=
